# 답변 생성 백엔드: gemini | ollama
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey — LLM_PROVIDER=gemini 면 필수(없으면 부팅 실패)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=ollama 일 때만 사용
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# ── 임베딩 백엔드: local | gemini ───────────────────────────────────────
# LLM_PROVIDER 와 독립이다 — 생성만 gemini 로 쓰고 임베딩은 로컬로 둘 수 있다.
# gemini 로 바꾸면 sentence-transformers/torch 가 아예 로드되지 않아 상주 메모리가
# ~2.6GB → ~300MB 로 떨어진다(1GB 급 인스턴스 배포용). 대신 셋을 감수해야 한다:
#   1. 벡터 공간이 달라져 기존 chroma 인덱스가 통째로 무효 → 전체 재인덱싱 필수
#   2. tuning.py 의 유사도 임계값(ABS_EMBED_FLOOR/ABS_EMBED_CONFIDENT)은 BGE-M3
#      실측값이다. 그대로 두면 가드레일이 오작동한다 → 반드시 재보정할 것
#   3. 오프라인/망분리 환경에서 못 돈다
EMBED_PROVIDER=local
# EMBED_PROVIDER=local 일 때. 바꾸면 재인덱싱 필요.
EMBED_MODEL=BAAI/bge-m3
# EMBED_PROVIDER=gemini 일 때만 사용(키는 위 GEMINI_API_KEY 를 공유).
# 차원은 128~3072 중 선택하며 권장값은 768/1536/3072.
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
CHROMA_DIR=./data/chroma
BM25_PATH=./data/bm25.pkl
LOGS_DB_PATH=./data/logs/chat_logs.db
ASSETS_DIR=./data/assets
RAW_DIR=./data/raw
PORT=8080
# 관리자 로그 조회 토큰. 설정해야 /admin/logs 가 활성화됨(미설정 시 404).
#   조회:   curl -H "X-Admin-Token: <TOKEN>" http://HOST:8080/admin/logs
#   CSV:    curl -H "X-Admin-Token: <TOKEN>" "http://HOST:8080/admin/logs?format=csv" -o logs.csv
ADMIN_TOKEN=

# ── 요청 상한 (ratelimit.py) ────────────────────────────────────────────
# /chat 은 호출마다 Gemini 과금이고 /consent 는 인증 없이 세션을 발급한다.
# 공개 배포에서 이 값들이 유일한 비용 방어선이다. 각 항목 0 = 비활성.
#
# 캠퍼스망은 NAT 뒤에 다수 사용자가 한 IP 를 공유하므로 IP 상한을 빡빡하게 잡으면
# 강의동 하나가 통째로 막힌다. 기본값은 넉넉히 두고 운영하며 조인다.
# 오늘 사용량은 GET /admin/usage (ADMIN_TOKEN 필요) 로 본다.
RL_CHAT_PER_SESSION=100      # 한 세션이 보낼 수 있는 질문 수
RL_CONSENT_PER_IP_HOUR=100   # IP당 시간당 세션 발급 수
RL_CHAT_PER_DAY=3000         # 전체 일일 질문 수 — 비용 최종 백스톱
# 매뉴얼에 근거 없는 질문 안내용 QnA 게시판 URL. 비우면 링크 없이 안내.
QNA_BOARD_URL=
