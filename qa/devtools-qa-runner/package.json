{
  "name": "devtools-qa-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Profile-driven QA runner powered by Chrome DevTools for Agents CLI",
  "license": "MIT",
  "keywords": [
    "chrome-devtools",
    "qa",
    "browser-automation",
    "mcp",
    "lighthouse"
  ],
  "bin": {
    "devtools-qa-runner": "src/cli.mjs"
  },
  "files": [
    "src",
    "profiles",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "find src test -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.mjs",
    "smoke:lms": "node src/cli.mjs --url https://121.145.133.68.sslip.io --profile profiles/lms-chatbot.json --timeout 120000",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "chrome-devtools-mcp": ">=1.1.0"
  },
  "devDependencies": {
    "chrome-devtools-mcp": "^1.1.0"
  }
}
