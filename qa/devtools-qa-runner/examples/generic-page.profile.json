{
  "name": "generic-page",
  "description": "Generic primitive scenario example for a simple page with a textbox and button.",
  "quality": {
    "ignoreSeo": true,
    "ignoreFavicon404": true
  },
  "scenarios": [
    {
      "type": "fill",
      "name": "fill-search",
      "target": { "role": "textbox", "nameIncludes": "Search" },
      "value": "hello world"
    },
    {
      "type": "press-key",
      "name": "submit-search",
      "key": "Enter"
    },
    {
      "type": "wait-for-text",
      "name": "wait-results",
      "text": "Results",
      "timeoutMs": 10000
    },
    {
      "type": "screenshot",
      "name": "results-screenshot"
    },
    {
      "type": "assert-no-console-errors",
      "name": "no-console-errors"
    },
    {
      "type": "assert-no-http-errors",
      "name": "no-http-errors",
      "ignoreFavicon404": true
    }
  ]
}
